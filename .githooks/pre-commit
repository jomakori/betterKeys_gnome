#!/bin/sh
# Minimal pre-commit hook to run lint checks on staged files.
# - Shell scripts: shellcheck (if available)
# - JS files: eslint (if available)
# - XML schema: xmllint

set -e

STAGED_FILES=$(git diff --cached --name-only --diff-filter=ACM)
if [ -z "$STAGED_FILES" ]; then
  exit 0
fi

EXIT_CODE=0

echo "Running pre-commit lint checks..."

for file in $STAGED_FILES; do
  case "$file" in
    *.sh)
      if command -v shellcheck >/dev/null 2>&1; then
        echo "shellcheck: $file"
        shellcheck -x "$file" || EXIT_CODE=1
      else
        echo "shellcheck not found; skipping $file"
      fi
      ;;
    *.js)
      if command -v eslint >/dev/null 2>&1; then
        echo "eslint: $file"
        eslint --max-warnings=0 "$file" || EXIT_CODE=1
      else
        echo "eslint not found; skipping $file"
      fi
      ;;
    *.xml)
      if command -v xmllint >/dev/null 2>&1; then
        echo "xmllint: $file"
        xmllint --noout "$file" || EXIT_CODE=1
      else
        echo "xmllint not found; skipping $file"
      fi
      ;;
    *)
      ;;
  esac
done

if [ $EXIT_CODE -ne 0 ]; then
  echo "Pre-commit checks failed. Aborting commit."
  exit $EXIT_CODE
fi

echo "Pre-commit checks passed."
exit 0
